<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp">

    <!-- 3 Stars Rating -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/star1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:src="@drawable/ic_star" />

        <ImageView
            android:id="@+id/star2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:src="@drawable/ic_star" />

        <ImageView
            android:id="@+id/star3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:src="@drawable/ic_star" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVictoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/victory_title"
        android:textColor="@color/brand_amber"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVictorySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/victory_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- IQ Gained Badge -->
    <TextView
        android:id="@+id/tvIqGained"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_card"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="+20 IQ"
        android:textColor="@color/brand_cyan"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Next Level Button -->
    <Button
        android:id="@+id/btnNextLevel"
        style="@style/GameButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="@string/btn_next_level" />

</LinearLayout>
